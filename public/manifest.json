{
  "manifest_version": 3,
  "name": "Focus Flow",
  "version": "1.0.0",
  "description": "Productivity and website blocking extension with Pomodoro timer",
  "icons": {
    "16": "icons/icon_new_16.png",
    "32": "icons/icon_new_32.png",
    "48": "icons/icon_new_48.png",
    "128": "icons/icon_new_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_new_16.png",
      "32": "icons/icon_new_32.png",
      "48": "icons/icon_new_48.png",
      "128": "icons/icon_new_128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [],
  "optional_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'self'; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self';"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js",
        "blocked-theme-init.js",
        "assets/*.css",
        "assets/*.js",
        "assets/fonts/*.woff2",
        "assets/fonts/*.woff",
        "assets/sounds/*.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}